# Cascade — environment template (mirrors CASCADE_BUILD_SPEC.md §2.1.3)
# Copy to .env and fill in. NEVER commit .env.

# --- Core ---------------------------------------------------------------
AWS_REGION=us-east-1

# Local dev (docker compose). Cloud value comes from Secrets Manager.
DATABASE_URL=postgresql://root@localhost:26257/cascade?sslmode=disable

# Day-0 stub toggle. true => core/contracts.py returns canned data, so the
# frontend and routers can be built before the engine exists (WORKFLOW.md §2).
# Flipping this to false IS the integration test.
CASCADE_STUB_MODE=true

# --- Bedrock (pinned model IDs, spec §2) --------------------------------
BEDROCK_AGENT_MODEL_ID=anthropic.claude-sonnet-5
BEDROCK_FAST_MODEL_ID=anthropic.claude-haiku-4-5
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# --- AWS resources ------------------------------------------------------
EPISODES_BUCKET=cascade-episodes-local
CASCADE_QUEUE_URL=
SNS_BUS_TOPIC_ARN=
ENABLE_SNS_FANOUT=false

# --- Secrets / auth (T3.1 RBAC) -----------------------------------------
# Three roles: viewer reads, operator runs tasks and approves gated actions,
# admin changes policy and resets the world.
#
# A token may carry a `name:` prefix so audit_log.actor records WHO acted
# rather than a shared literal — e.g. `x-admin-token: ashfaq:dev-admin-token`.
# `Authorization: Bearer <token>` works equally.
ADMIN_TOKEN=dev-admin-token
OPERATOR_TOKEN=dev-operator-token
VIEWER_TOKEN=dev-viewer-token
INTERNAL_SSE_SECRET=dev-internal-secret
WEBHOOK_SECRET=dev-webhook-secret

# --- Observability (T3.3) -----------------------------------------------
# Empty disables tracing entirely — the app never blocks on a collector that
# isn't there. Spans carry ids, tool names and outcomes; never payloads.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=cascade-api
OTEL_CONSOLE_EXPORT=false

# --- Retention (T3.4) ----------------------------------------------------
# Applied by migrations/004_production.sql. Provenance tables (rules,
# playbooks, playbook_deps, anti_playbooks) deliberately never expire.
AUDIT_LOG_RETENTION_DAYS=90
EPISODE_RETENTION_DAYS=30

# --- Worker -> API bridge -----------------------------------------------
API_BASE_URL=http://localhost:8000

# Run the outbox worker inside the API process. Local dev has no SQS and no
# Lambda, so without this the learn loop stops at "compile event queued" and no
# playbook is ever compiled. Deployments MUST leave this false — Lambda owns the
# queue there, and two consumers would race for the same outbox rows.
RUN_WORKER_IN_PROCESS=false
LOCAL_WORKER_INTERVAL_SECONDS=2.0

# --- Budgets (spec §5.4) ------------------------------------------------
MAX_STEPS_PER_TASK=15
MAX_WALL_CLOCK_SECONDS=60
MAX_TOKENS_PER_TASK=25000
MAX_CONCURRENT_TASKS=5

# --- Retrieval tuning (D3 — L2 distance, NOT cosine) --------------------
RETRIEVAL_L2_THRESHOLD=0.85
DEDUP_L2_THRESHOLD=0.40

# --- Feature flags ------------------------------------------------------
ENABLE_OUTBOUND_WEBHOOK=false

# --- Frontend (frontend/.env.local) -------------------------------------
# Local:  http://127.0.0.1:8000
# Deployed: https://<dist>.cloudfront.net   <-- NEVER the raw ALB URL.
#   Amplify serves over https; a browser blocks calls to an http origin as
#   mixed content, and the SSE stream dies silently with it.
#   06_deploy_frontend.sh refuses to build against a non-https URL.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
#
# DO NOT put the admin token in a NEXT_PUBLIC_ variable. NEXT_PUBLIC_* is
# inlined into the client bundle at build time, so that publishes the
# credential in the page source. Privileged calls go through the server-side
# proxy (frontend/src/app/api/proxy/[...path]/route.ts), which reads these two
# — both server-only:
#
#   CASCADE_API_URL=<same value as NEXT_PUBLIC_API_URL>
#   ADMIN_TOKEN=<matches ADMIN_TOKEN above>
#
# The proxy stops the credential leaking. It is NOT access control: without a
# login, anyone who can reach the site can still invoke those operations. To
# gate the site itself, deploy with DEMO_PASSWORD set (Amplify basic auth).

# --- Alternate LLM providers (deviation #11) -----------------------------
# Bedrock stays primary. These let the full learn/reuse/unlearn loop run on
# free-tier keys during development. Whenever one of them serves a request,
# llm_status() reports "degraded" and /api/admin/smoke names the provider.
#   chat:       bedrock -> groq -> openrouter -> local deterministic planner
#   embeddings: bedrock -> huggingface        -> local deterministic embedder
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# HF_API_KEY=
# Must be 1024-d to match playbooks.embedding VECTOR(1024) and its index.
HF_EMBED_MODEL=BAAI/bge-large-en-v1.5

# --- Autonomy gating (T1.1) ----------------------------------------------
# Tier-1 production-critical services ALWAYS require sign-off for irreversible
# actions; that is not configurable. This is an optional second gate on runbook
# confidence: set 0.6 to make a new runbook earn autonomy over three
# supervised successes (0.30 -> 0.45 -> 0.60). Off by default because it stops
# every first reuse — enable it deliberately.
AUTONOMY_MIN_CONFIDENCE=0.0

# Blended USD per 1M tokens, used to price measured token savings (T1.4).
USD_PER_MTOK=1.60

# --- Bedrock credentials -------------------------------------------------
# Not set here in dev: boto3 resolves them from ~/.aws/credentials, the
# instance role, or the ECS task role. When none resolve, the engine falls back
# to a deterministic local path and reports llm="degraded" at /api/metrics and
# /api/admin/smoke — it never silently pretends to be using Bedrock.
#
# Bedrock model access must ALSO be granted manually per account+region in the
# console, or every call returns AccessDeniedException. That approval is not
# instant — request it before you need it.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
