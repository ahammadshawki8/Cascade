# --- Secrets — never commit ---------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
credentials.json

# --- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/

# --- Node / Next.js ------------------------------------------------------
node_modules/
.next/
out/
# ...except the evaluation's results, which are evidence rather than build
# output. Every claim in IMPROVEMENT_CHANGELOG.md and the Evidence view is
# read from these files, so a reader who cannot see them has to take the
# numbers on trust.
!backend/eval/out/
!backend/eval/out/**
.turbo/
npm-debug.log*

# --- AWS / deploy artifacts ---------------------------------------------
*.zip
.aws-sam/
lambda-package/

# --- Local data ----------------------------------------------------------
cockroach-data/
*.db

# --- Editor / OS ---------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# --- Media working files (keep final assets in docs/) --------------------
recordings/
*.mkv
