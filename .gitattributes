# Normalise line endings. Without this, bash scripts authored on Windows
# arrive with CRLF and fail at runtime with: $'\r': command not found
* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.sql   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
Makefile text eol=lf

# Binary assets — never normalise
*.png   binary
*.jpg   binary
*.gif   binary
*.mp4   binary
*.ico   binary
